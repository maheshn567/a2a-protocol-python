# -----------------------------------------------------------------------------
# Agent2Agent (A2A) LLM Provider Configuration Template
# -----------------------------------------------------------------------------
# You can use any OpenAI-compatible API provider (NVIDIA NIM, OpenAI, Groq, Ollama, OpenRouter).

# Option 1: NVIDIA NIM (Default)
base_url="https://integrate.api.nvidia.com/v1"
api_key="YOUR_API_KEY"
model="meta/llama-3.1-70b-instruct"
# Alternative NVIDIA models:
# model="nvidia/nemotron-4-340b-instruct"
# model="deepseek-ai/deepseek-r1"

# Option 2: OpenAI Official
# base_url="https://api.openai.com/v1"
# API_KEY="sk-proj-YOUR_OPENAI_KEY"
# model="gpt-4o-mini"

# Option 3: Groq (Ultra fast inference)
# base_url="https://api.groq.com/openai/v1"
# API_KEY="gsk_YOUR_GROQ_KEY"
# model="llama-3.3-70b-versatile"

# Option 4: OpenRouter (Multi-model gateway)
# base_url="https://openrouter.ai/api/v1"
# API_KEY="sk-or-v1-YOUR_OPENROUTER_KEY"
# model="meta-llama/llama-3.1-70b-instruct"

# Option 5: Local Ollama (No API Key required)
# base_url="http://localhost:11434/v1"
# API_KEY="ollama"
# model="llama3"
